# Alpine-Contributor: A. Wilcox <awilfox@adelielinux.org>
# Alpine-Maintainer: Simon Rupf <simon@rupf.net>
pkgname=man-db
pkgver=2.13.1
pkgrel=0
pkgdesc="The man command and related utilities for examining on-line help files"
url="https://man-db.gitlab.io/man-db/"
vcs_url="https://gitlab.com/man-db/man-db"
arch="all"
license="GPL-2.0-or-later"
depends="groff gdbm gettext libintl zlib-ng libpipeline qnx-io-sock"
makedepends="gdbm-dev gettext-dev zlib-ng-dev libpipeline-dev qnx-io-sock-dev"
subpackages="$pkgname-lang $pkgname-doc"
source="https://download.savannah.nongnu.org/releases/man-db/man-db-$pkgver.tar.xz"
triggers="man-db.trigger=/usr/share/man"

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --localstatedir=/var \
        --disable-setuid \
	--enable-cache-owner=root \
        --with-sections="1 1p 1x 2 2x 3 3p 3const 3head 3type 3x 4 4x 5 5x 6 6x 7 7x 8 8x 9 0p tcl n l p o" \
        --enable-nls \
        --with-db=gdbm
    make
}

package() {
    make DESTDIR="$pkgdir" install
}


sha512sums="
